# ---- LLM (OpenRouter) ---------------------------------------------------
# OpenRouter serves Anthropic's wire at /v1/messages, so it is the same SDK;
# only the base URL and the model id change. Unset LLM_BASE_URL to hit
# Anthropic directly, in which case use a bare model id like claude-opus-5.
LLM_BASE_URL=https://openrouter.ai/api
LLM_API_KEY=sk-...
LLM_MODEL=google/gemini-3.6-flash
LLM_MODEL_CHEAP=google/gemini-3.1-flash-lite

# ---- infra --------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://nakhatra:nakhatra@localhost:5432/nakhatra
REDIS_URL=redis://localhost:6379/0

# ---- auth ---------------------------------------------------------------
# Sign tokens with a fresh random value: openssl rand -hex 32
# Must be >= 32 chars. The app refuses to boot otherwise. Rotating it logs everyone out.
JWT_SECRET=
JWT_EXPIRE_MINUTES=43200

# ---- astrology ----------------------------------------------------------
# Swiss Ephemeris data files. Download separately; do not commit.
EPHEMERIS_PATH=./ephe

# ---- Google sign-in -----------------------------------------------------
# Unset disables POST /v1/auth/google with a 503 rather than accepting any
# audience. The secret is needed for the web client's popup auth-code flow —
# the flow that lets the sign-in button be ours instead of one Google renders.
# The mobile ID-token flow needs only the id.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GEMINI_API_KEY=
